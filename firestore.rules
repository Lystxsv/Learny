rules_version = '2';

// Learny · reglas de Firestore.
// Hoy Learny NO usa Firestore: los datos viven solo en el navegador y la sesión (Auth) no necesita Firestore.
// Por eso la regla es «denegar todo»: si alguien consulta la base con la configuración pública del proyecto, no obtiene nada.
// Cuando llegue el Bloque 3 (sincronización), sustituye este archivo por reglas por usuario, p. ej.:
//   match /users/{uid}/{document=**} { allow read, write: if request.auth != null && request.auth.uid == uid; }
// y valida tipos y tamaños en `write`. Despliegue: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
